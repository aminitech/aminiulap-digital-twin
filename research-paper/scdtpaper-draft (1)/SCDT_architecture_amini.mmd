%%{init: {"theme":"base","themeVariables":{"fontFamily":"Helvetica Neue, Helvetica, Arial, sans-serif","primaryColor":"#202020","primaryTextColor":"#FFFFFF","primaryBorderColor":"#333333","lineColor":"#7d7d7d","textColor":"#FFFFFF","clusterBkg":"#171717","clusterBorder":"#2A2A2A","titleColor":"#FFFFFF","edgeLabelBackground":"#121212","background":"#121212","fontSize":"15px"},"flowchart":{"htmlLabels":false,"curve":"basis","padding":14}} }%%
flowchart TB
  classDef card fill:#202020,stroke:#333333,color:#FFFFFF;
  classDef hero fill:#202020,stroke:#FFC83C,color:#FFC83C,stroke-width:2px;
  classDef ext  fill:#161616,stroke:#333333,color:#9A9A9A,stroke-dasharray:4 3;

  subgraph SENSE["1 - Sensing Layer: Network as a Sensor (NaaS)"]
    direction LR
    ISAC["6G ISAC Cell Towers<br/>Dual-Function Radar-Comm<br/>rainfall / flood / motion / mobility"]
    EO["Satellite EO / NTN"]
    IOT["IoT and Ground Telemetry<br/>tide / grid / water"]
    DEV["Edge Devices and Laptops<br/>opportunistic sensing"]
  end

  subgraph CUBE["2 - GeoPackage Transformation (Amini Patent)"]
    direction LR
    GP["GeoPackage Engine<br/>ingest / fuse / index"]
    STC["Spatio-Temporal Data Cubes<br/>X / Y / Z / Time"]
  end

  subgraph NODES["3 - Amini Node Network: Distributed Compute"]
    direction LR
    CT["Cell-Tower<br/>Edge Nodes"]
    MDC["Modular<br/>Data Centers"]
    SRV["Distributed<br/>Servers"]
    LAP["Laptops<br/>and Devices"]
  end

  CHAIN[("Amini Chain - Blockchain Backbone<br/>content hashing / provenance / node attestation")]

  subgraph TRUST["Zero-Trust and Integrity Spine"]
    direction TB
    ATT["Source Attestation<br/>providers untrusted by default"]
    QUAL["Quality and Integrity<br/>Validation"]
    PRIV["Privacy Tiers L1 / L2 / L3<br/>+ consent"]
    MRV["MRV / Climate-Finance Proofs"]
  end

  subgraph LAKE["4 - National Sovereign Data Lake"]
    direction LR
    INGEST["Validated Cube Ingestion"]
    CATALOG[("Catalog +<br/>Versioned State")]
    INGEST --> CATALOG
  end

  subgraph SCDT["5 - Sovereign Cognitive Digital Twin"]
    direction LR
    SYNC["Synchronization Engine<br/>belief-state / EKF"]
    SIM["Simulation and ML Surrogates<br/>coastal / hydrology / evacuation"]
    AIRAN["AI-RAN Cognitive Orchestration<br/>O-RAN RIC / PPO"]
    SYNC --> SIM
    SIM <--> AIRAN
  end

  subgraph UX["6 - Interaction and Orchestration"]
    direction LR
    NLQ["GenAI NL Query<br/>ChatBB / GovChat"]
    DASH["Executive Dashboards"]
    CTRL["Closed-Loop Control APIs"]
  end

  EXT["External Climate Finance<br/>and Registries"]

  ISAC --> GP
  EO --> GP
  IOT --> GP
  DEV --> GP

  GP --> STC
  STC -->|"sharded + distributed"| CT
  STC --> MDC
  STC --> SRV
  STC --> LAP

  CT -.-> CHAIN
  MDC -.-> CHAIN
  SRV -.->|"register + content-hash + attest"| CHAIN
  LAP -.-> CHAIN

  CHAIN === ATT
  ATT --> QUAL
  CHAIN -->|"attestation-gated cubes"| QUAL
  PRIV -.->|"gates capture"| GP

  QUAL -->|"only verified, integrity-checked cubes"| INGEST
  CATALOG --> SYNC

  SIM --> NLQ
  SIM --> DASH
  AIRAN --> CTRL
  CTRL -.->|"beam + sensing control (closed loop)"| ISAC

  CHAIN -.-> MRV
  MRV -.-> EXT

  class ISAC,EO,IOT,DEV,GP,CT,MDC,SRV,LAP,ATT,QUAL,PRIV,MRV,INGEST,CATALOG,SYNC,SIM,AIRAN,NLQ,DASH,CTRL card;
  class CHAIN,STC hero;
  class EXT ext;

  linkStyle 16 stroke:#FFC83C,stroke-width:2px;
  linkStyle 25 stroke:#FFC83C,stroke-width:2px;
